# The port that your project will run on - default is 3301
# PORT_PROJECT=3301

# The port that your lens instance will run on - default is 3300
# PORT_FXSTUDIO=3300

# Whether to run a project - set this to 0 when you're running your project 
# separately and set the PORT_PROJECT (above) to whatever port that's running on.
# RUN_PROJECT=0

# OSC bridge (npm run osc:bridge) — TouchDesigner UDP
#
# TouchDesigner OSC Out — config recommandée (local, plus simple que multicast):
#   Protocol: Messaging (UDP)
#   Network Address: 127.0.0.1
#   Network Port: 1337
#   Local Address: 10.0.0.114
#   Local Port: (vide / auto — ne pas mettre 1337)
#
# Multicast alternative:
#   Protocol: Multi-Cast Messaging (UDP)
#   Network Address: 239.255.0.1
#   Network Port: 1337
#
# Test sans TD: npm run osc:test
OSC_PORTS=1337,1338
OSC_MULTICAST=239.255.0.1
OSC_LOCAL_ADDRESS=10.0.0.114
OSC_WS_PORT=3302
OSC_HOST=0.0.0.0